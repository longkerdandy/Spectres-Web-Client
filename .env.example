# AG-UI endpoint of the Spectres Runtime (AgentOS).
VITE_AGENT_ENDPOINT=http://localhost:7777/agui

# Logto IdP (OIDC) configuration — see Runtime ADR 0009.
# Base URL of the Logto server (the OIDC issuer is <endpoint>/oidc).
VITE_LOGTO_ENDPOINT=http://localhost:3001
# App ID of this SPA application as registered in the Logto Console.
VITE_LOGTO_APP_ID=20vb1euxbpw6m8nqdgkxs
# API resource indicator (audience) — the Runtime only accepts JWT access
# tokens issued for this resource.
VITE_LOGTO_API_RESOURCE=https://spectres.runtime/api
